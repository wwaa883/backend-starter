# 复制成 .env 后按自己的环境改（.env 不提交到 Git）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=demo
PORT=3000

# 允许跨域访问的前端地址，逗号分隔；不配则只放行本地开发前端
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 只在前面挂了 Nginx / 容器入口 / 云负载均衡时才配：数字是信任的代理跳数，
# 配了以后 req.ip 才是真实客户端 IP，限流才按人算。直连部署别配，否则 X-Forwarded-For 可被伪造
# TRUST_PROXY=1
